---
import BaseLayout from "@/layouts/BaseLayout.astro";

const links = [
    {
        label: "GitHub",
        href: "https://github.com/kevinjin0420",
        host: "github.com/kevinjin0420",
    },
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/in/kevinjin0420/",
        host: "linkedin.com/in/kevinjin0420",
    },
    {
        label: "Email",
        href: "mailto:kevinjin0420@gmail.com",
        host: "kevinjin0420@gmail.com",
    },
    {
        label: "Resume",
        href: "https://resume.kevinjin.dev/resume.pdf",
        host: "resume.kevinjin.dev",
    },
    {
        label: "Dotfiles",
        href: "https://github.com/kevinjin0420/dotfiles",
        host: "github.com/kevinjin0420/dotfiles",
    },
    { label: "Projects", href: "/projects", arrow: true },
];
---

<!-- easter egg lives at /terminal -->
<BaseLayout title="Kevin Jin">
    <h1 class="name text-2xl font-semibold">
        <span class="given"
            ><span class="given__short">Kevin</span><span
                class="given__full"
                aria-hidden="true">Shengran</span
            ></span
        > Jin
    </h1>
    <p class="micro-heading mt-2">
        Computer Engineering &middot; University of Michigan
    </p>
    <p class="micro-heading mt-4">Links</p>
    <ul
        class="mt-2 border border-[color:var(--color-border)] divide-y divide-[color:var(--color-border)]"
    >
        {
            links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="flex items-center justify-between px-3 py-2 text-sm hover:bg-[color:var(--color-hover)]"
                        {...(link.host
                            ? { target: "_blank", rel: "noopener noreferrer" }
                            : {})}
                    >
                        <span>{link.label}</span>
                        {link.host && (
                            <span class="font-mono text-xs text-[color:var(--color-fg-muted)]">
                                {link.host}
                            </span>
                        )}
                        {link.arrow && (
                            <span
                                aria-hidden="true"
                                class="font-mono text-xs text-[color:var(--color-fg-muted)]"
                            >
                                &rarr;
                            </span>
                        )}
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>

<style>
    .given {
        display: inline-block;
        position: relative;
        overflow: hidden;
        white-space: nowrap;
        vertical-align: bottom;
        width: var(--given-w, auto);
        transition: width 380ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .given__short,
    .given__full {
        transition: opacity 380ms ease;
    }
    .given__full {
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
    }
    .name:hover .given {
        width: var(--given-w-full, auto);
    }
    .name:hover .given__short {
        opacity: 0;
    }
    .name:hover .given__full {
        opacity: 1;
    }
    @media (prefers-reduced-motion: reduce) {
        .given,
        .given__short,
        .given__full {
            transition: none;
        }
    }
</style>

<script>
    const given = document.querySelector<HTMLElement>(".name .given");
    const short = given?.querySelector<HTMLElement>(".given__short");
    const full = given?.querySelector<HTMLElement>(".given__full");

    if (given && short && full) {
        const sync = () => {
            given.style.setProperty("--given-w", `${short.offsetWidth}px`);
            given.style.setProperty("--given-w-full", `${full.offsetWidth}px`);
        };
        sync();
        document.fonts?.ready.then(sync);
        window.addEventListener("resize", sync);
    }
</script>
